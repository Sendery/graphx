{
  "name": "graphx",
  "version": "1.9.0",
  "private": true,
  "description": "Motor de diagramas navegables para artifacts: un JSON → layout ELK jerárquico, niveles plegables, tooltips, panel, secuencias y recorrido guiado.",
  "type": "module",
  "scripts": {
    "build": "node graphx-build.mjs",
    "check": "node graphx-build.mjs --check",
    "verify:mermaid": "node tools/verify-mermaid.mjs",
    "verify:shapes": "node tools/verify-shapes.mjs",
    "verify:tree": "node tools/verify-tree.mjs",
    "verify:fx": "node tools/verify-fx.mjs",
    "tree": "node tools/tree-spec.mjs",
    "gallery": "node examples/gallery/build.mjs"
  },
  "devDependencies": {
    "jsdom": "^24.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "exports": {
    "./engine": "./graphx.js",
    "./shapes": "./graphx-shapes.js",
    "./mermaid": "./graphx-mermaid.js",
    "./graphx.css": "./graphx.css",
    "./react": {
      "types": "./react/index.d.ts",
      "import": "./react/index.mjs"
    },
    "./layouts": "./graphx-layouts.js",
    "./tree": "./graphx-tree.js",
    "./fx": "./graphx-fx.js"
  },
  "peerDependencies": {
    "react": ">=16.8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
