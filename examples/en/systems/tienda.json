  "loops": [
    {
      "edges": [
        "s1",
        "s2",
        "s3",
        "s4"
      ],
      "label": "advertising brings customers"
    },
    {
      "edges": [
        "s10",
        "s11",
        "s12"
      ],
      "label": "hire to keep the promise",
      "goal": "deliver within 48 h"
    },
    {
      "edges": [
        "s1",
        "s5",
        "s6",
        "s7",
        "s8",
        "s9"
      ],
      "label": "success saturates the warehouse"
    }
  ],
  "tour": {
    "title": "Why selling more is not enough",
    "steps": [
      {
        "title": "The engine: R1",
        "body_html": "More customers, more orders, more revenue and more ads, which bring more customers. On its own it would grow without limit.",
        "focus": {
          "nodes": [
            "clientes",
            "pedidos",
            "ingresos",
            "publicidad"
          ],
          "edges": [
            "s1",
            "s2",
            "s3",
            "s4"
          ]
        }
      },
      {
        "title": "The brake: B2",
        "body_html": "The same orders fill the warehouse, delivery time goes up and satisfaction goes down (−). Reviews take two months to show it.",
        "focus": {
          "nodes": [
            "pedidos",
            "carga",
            "plazo",
            "satisfaccion",
            "resenas",
            "clientes"
          ],
          "edges": [
            "s5",
            "s6",
            "s7",
            "s8",
            "s9"
          ]
        }
      },
      {
        "title": "The late response: B1",
        "body_html": "Hiring brings delivery time down, but takes six weeks: it balances with a delay and tends to overshoot, with a full warehouse and then too many people.",
        "focus": {
          "nodes": [
            "plazo",
            "contratacion",
            "personal"
          ],
          "edges": [
            "s10",
            "s11",
            "s12"
          ]
        }
      }
    ]
  }
