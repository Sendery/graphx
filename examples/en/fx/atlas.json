{
 "title": "Online store",
 "summary": "An atlas: the same system seen from five questions. The nodes are the same in every perspective: each node's card says where else it appears, what constrains it and what worries us about it.",
 "owners": {
  "web": {
   "label": "Web team",
   "short": "WB",
   "color": "#2563eb",
   "contact": "#web"
  },
  "checkout": {
   "label": "Checkout",
   "short": "CO",
   "color": "#0b7480",
   "contact": "#checkout"
  },
  "pagos": {
   "label": "Payments",
   "short": "PG",
   "color": "#8250df",
   "contact": "#payments"
  },
  "plataforma": {
   "label": "Platform",
   "short": "PF",
   "color": "#b45309",
   "contact": "#platform"
  },
  "datos": {
   "label": "Data",
   "short": "DT",
   "color": "#16a34a",
   "contact": "#data"
  }
 },
 "entities": {
  "web": {
   "label": "Web store",
   "kind": "ui",
   "owner": "web",
   "path": "apps/web",
   "summary": "The store in the browser: catalog, cart and checkout."
  },
  "app": {
   "label": "Mobile app",
   "kind": "mobile",
   "owner": "web",
   "path": "apps/mobile",
   "summary": "The iOS and Android app; it talks to the same gateway."
  },
  "gateway": {
   "label": "API Gateway",
   "kind": "service",
   "owner": "plataforma",
   "path": "infra/gateway",
   "summary": "The single way in: authenticates, rate-limits and routes.",
   "doc": {
    "context": "All client traffic has come in here since 2024; before that, every service had its own domain.",
    "constraints": [
     "No business logic in the gateway",
     "Limit of 50 requests/s per client"
    ]
   }
  },
  "auth": {
   "label": "Identity",
   "kind": "lock",
   "owner": "plataforma",
   "path": "services/auth",
   "summary": "Sessions and tokens; validates every gateway request."
  },
  "catalogo": {
   "label": "Catalog",
   "kind": "search",
   "owner": "web",
   "path": "services/catalog",
   "summary": "Products, prices and search; almost everything comes from Redis."
  },
  "carrito": {
   "label": "Cart",
   "kind": "cart",
   "owner": "checkout",
   "path": "services/cart",
   "summary": "Each customer's cart and the step to an order."
  },
  "pedidos": {
   "label": "Orders",
   "kind": "service",
   "owner": "checkout",
   "path": "services/orders",
   "inner": "pedido-estados",
   "summary": "Creates the order, charges it through Payments and tells everyone else through Kafka.",
   "doc": {
    "context": "The heart of checkout. It owns the order's state: nobody else changes it.",
    "constraints": [
     "No order is created without an authorized charge",
     "Every state change publishes an event"
    ],
    "risks": [
     "If Kafka doesn't accept the event, stock isn't reserved: today it's retried in memory"
    ],
    "todo": [
     {
      "text": "Transactional outbox for events",
      "done": false
     },
     {
      "text": "Idempotent “Create order”",
      "done": true
     }
    ]
   }
  },
  "pagos": {
   "label": "Payments",
   "kind": "card",
   "owner": "pagos",
   "path": "services/payments",
   "inner": "pagos-dentro",
   "summary": "Authorizes the charge: asks Fraud check, then the gateway.",
   "doc": {
    "context": "Replaces the monolith's payments module since sprint 42.",
    "constraints": [
     "PCI: the card number never leaves the tokenizer",
     "3 s total timeout towards the payment gateway"
    ],
    "risks": [
     "Fraud check is on the critical path: if it's slow, the charge is slow"
    ],
    "todo": [
     {
      "text": "Retry queue for the payment gateway",
      "done": true
     },
     {
      "text": "Asynchronous fraud check under €30",
      "done": false
     }
    ]
   }
  },
  "antifraude": {
   "label": "Fraud check",
   "kind": "shield",
   "owner": "pagos",
   "path": "services/fraud",
   "summary": "Scores each charge's risk with a model; above 0.8 it rejects it.",
   "doc": {
    "context": "An in-house model retrained every week with chargebacks.",
    "constraints": [
     "Answer in under 300 ms or the charge goes on unscored"
    ],
    "risks": [
     "p95 is around 480 ms during sales: above its target",
     "A badly deployed model rejects good charges"
    ],
    "todo": [
     {
      "text": "Per-customer score cache",
      "done": false
     },
     {
      "text": "Canary deployment for the model",
      "done": false
     }
    ]
   }
  },
  "stock": {
   "label": "Stock",
   "kind": "service",
   "owner": "checkout",
   "path": "services/inventory",
   "summary": "Reserves units when “order.created” arrives and tells the warehouse.",
   "doc": {
    "risks": [
     "If the event arrives late, we can sell what we don't have"
    ]
   }
  },
  "notificaciones": {
   "label": "Notifications",
   "kind": "bell",
   "owner": "plataforma",
   "path": "services/notify",
   "summary": "Emails and push notifications from the events."
  },
  "postgres": {
   "label": "PostgreSQL",
   "kind": "datastore",
   "owner": "datos",
   "path": "infra/postgres",
   "summary": "Orders and charges. One primary and two replicas.",
   "doc": {
    "constraints": [
     "Only Orders and Payments write",
     "Hourly backups, kept 30 days"
    ],
    "risks": [
     "A single primary: if it goes down, all of checkout stops"
    ]
   }
  },
  "redis": {
   "label": "Redis",
   "kind": "cache",
   "owner": "plataforma",
   "path": "infra/redis",
   "summary": "Cache for the catalog and the sessions."
  },
  "kafka": {
   "label": "Kafka",
   "kind": "queue",
   "owner": "datos",
   "path": "infra/kafka",
   "summary": "The event bus: order.created, payment.completed, stock.reserved.",
   "doc": {
    "context": "Three brokers; events are kept for 7 days.",
    "risks": [
     "During sales, consumer lag reaches 90 s"
    ]
   }
  },
  "pasarela": {
   "label": "Payment gateway",
   "kind": "external",
   "path": "—",
   "summary": "The external provider that authorizes cards."
  },
  "almacen": {
   "label": "Warehouse (WMS)",
   "kind": "external",
   "summary": "The warehouse system: receives reservations and prepares shipments."
  },
  "lake": {
   "label": "Data lake",
   "kind": "cloud",
   "owner": "datos",
   "path": "data/lake",
   "summary": "Every event, for analytics and to retrain Fraud check."
  },
  "email": {
   "label": "Email provider",
   "kind": "mail",
   "summary": "The external service that sends the emails."
  },
  "reintentos": {
   "label": "Retry queue",
   "kind": "queue",
   "owner": "pagos",
   "path": "services/payments/retry",
   "summary": "Retries charges that fail at the payment gateway, with growing back-off.",
   "doc": {
    "context": "New in sprint 42.",
    "todo": [
     {
      "text": "Alert if the queue goes over 100",
      "done": false
     }
    ]
   }
  },
  "pagos-legado": {
   "label": "Payments (monolith)",
   "kind": "package",
   "owner": "pagos",
   "path": "legacy/monolith/payments",
   "summary": "The monolith's payments module. Retired in sprint 42."
  }
 },
