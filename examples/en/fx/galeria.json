      "files": [
        {
          "path": "orders/validate.ts",
          "additions": 84,
          "deletions": 3
        }
      ],
      "summary": "A new part in a diff, with its files.",
      "blocks": [
        {
          "type": "code",
          "lang": "ts",
          "code": "// rejects orders with no lines or with negative amounts\nexport function validate(o: Order): Result {\n  if (!o.lines.length) return fail(\"empty\");\n  return o.total >= 0 ? ok(o) : fail(\"amount\");\n}"
        }
