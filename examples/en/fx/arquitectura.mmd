flowchart LR
  %% This is valid Mermaid: GraphX data goes in @{…} and in %% @gx comments, which Mermaid ignores.
  %% @gx { "owners": { "busqueda": { "label": "Search team", "short": "SR", "contact": "#search" }, "datos": { "label": "Data", "short": "DT" } } }
  %% @gx { "fx": { "particles": true, "heat": { "label": "p95 latency", "unit": "ms", "domain": [0, 400] } } }
  usuario([User]) e1@--> buscador{{Search API}}
  buscador@{ heat: 85, spark: "40 52 61 58 70 84 79 85", unit: "ms", owner: busqueda }
  buscador e2@--> decide{Cached?}
  decide -->|yes| cache((Redis))
  decide -->|no| indice[(Elasticsearch)]
  indice@{ heat: 240, progress: 0.82, owner: datos, alert: warn }
  cache@{ heat: 4, owner: datos }
  indice e3@--> ranking[/ML ranking/]
  ranking@{ heat: 130, spark: "90 110 105 130 128 140 133 130", unit: "ms", owner: busqueda }
  ranking --> resultado[Results]
  e1@{ rate: 900 }
  e2@{ rate: 900, speed: fast }
  e3@{ rate: 300 }
