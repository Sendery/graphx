  "web": {
   "label": "Tienda web",
   "kind": "ui",
   "owner": "web",
   "path": "apps/web",
   "summary": "La tienda en el navegador: catálogo, carrito y compra."
  },
  "app": {
   "label": "App móvil",
   "kind": "mobile",
   "owner": "web",
   "path": "apps/mobile",
   "summary": "La app de iOS y Android; habla con el mismo gateway."
  },
  "gateway": {
   "label": "API Gateway",
   "kind": "service",
   "owner": "plataforma",
   "path": "infra/gateway",
   "summary": "La única puerta de entrada: autentica, limita y enruta.",
   "doc": {
    "context": "Todo el tráfico de clientes entra por aquí desde 2024; antes cada servicio tenía su propio dominio.",
    "constraints": [
     "Nada de lógica de negocio en el gateway",
     "Límite de 50 peticiones/s por cliente"
    ]
   }
  },
  "auth": {
   "label": "Identidad",
   "kind": "lock",
   "owner": "plataforma",
   "path": "services/auth",
   "summary": "Sesiones y tokens; valida cada petición del gateway."
  },
  "catalogo": {
   "label": "Catálogo",
   "kind": "search",
   "owner": "web",
   "path": "services/catalog",
   "summary": "Productos, precios y búsqueda; casi todo sale de Redis."
  },
  "carrito": {
   "label": "Carrito",
   "kind": "cart",
   "owner": "checkout",
   "path": "services/cart",
   "summary": "El carrito de cada cliente y el paso a pedido."
  },
  "pedidos": {
   "label": "Pedidos",
   "kind": "service",
   "owner": "checkout",
   "path": "services/orders",
   "inner": "pedido-estados",
   "summary": "Crea el pedido, lo cobra a través de Pagos y avisa al resto por Kafka.",
   "doc": {
    "context": "El corazón del checkout. Es el dueño del estado del pedido: nadie más lo cambia.",
    "constraints": [
     "Un pedido no se crea sin cobro autorizado",
     "Cada cambio de estado publica un evento"
    ],
    "risks": [
     "Si Kafka no acepta el evento, el stock no se reserva: hoy se reintenta en memoria"
    ],
    "todo": [
     {
      "text": "Outbox transaccional para los eventos",
      "done": false
     },
     {
      "text": "Idempotencia en «Crear pedido»",
      "done": true
     }
    ]
   }
  },
  "pagos": {
   "label": "Pagos",
   "kind": "card",
   "owner": "pagos",
   "path": "services/payments",
   "inner": "pagos-dentro",
   "summary": "Autoriza el cobro: pregunta a Antifraude y después a la pasarela.",
   "doc": {
    "context": "Sustituye al módulo de pagos del monolito desde el sprint 42.",
    "constraints": [
     "PCI: el número de tarjeta nunca sale del tokenizador",
     "Timeout total de 3 s hacia la pasarela"
    ],
    "risks": [
     "Depende de Antifraude en el camino crítico: si tarda, el cobro tarda"
    ],
    "todo": [
     {
      "text": "Cola de reintentos para la pasarela",
      "done": true
     },
     {
      "text": "Antifraude asíncrono por debajo de 30 €",
      "done": false
     }
    ]
   }
  },
  "antifraude": {
   "label": "Antifraude",
   "kind": "shield",
   "owner": "pagos",
   "path": "services/fraud",
   "summary": "Puntúa el riesgo de cada cobro con un modelo; por encima de 0,8 lo rechaza.",
   "doc": {
    "context": "Modelo propio reentrenado cada semana con los contracargos.",
    "constraints": [
     "Responder en menos de 300 ms o el cobro sigue sin puntuación"
    ],
    "risks": [
     "El p95 ronda los 480 ms en las rebajas: está por encima de su objetivo",
     "Un modelo mal desplegado rechaza cobros buenos"
    ],
    "todo": [
     {
      "text": "Caché de puntuaciones por cliente",
      "done": false
     },
     {
      "text": "Despliegue canario del modelo",
      "done": false
     }
    ]
   }
  },
  "stock": {
   "label": "Stock",
   "kind": "service",
   "owner": "checkout",
   "path": "services/inventory",
   "summary": "Reserva unidades cuando llega «pedido.creado» y avisa al almacén.",
   "doc": {
    "risks": [
     "Si el evento llega tarde se puede vender lo que no hay"
    ]
   }
  },
  "notificaciones": {
   "label": "Notificaciones",
   "kind": "bell",
   "owner": "plataforma",
   "path": "services/notify",
   "summary": "Emails y avisos push a partir de los eventos."
  },
  "postgres": {
   "label": "PostgreSQL",
   "kind": "datastore",
   "owner": "datos",
   "path": "infra/postgres",
   "summary": "Pedidos y cobros. Un primario y dos réplicas.",
   "doc": {
    "constraints": [
     "Solo Pedidos y Pagos escriben",
     "Copias cada hora, 30 días"
    ],
    "risks": [
     "Un único primario: su caída para el checkout entero"
    ]
   }
  },
  "redis": {
   "label": "Redis",
   "kind": "cache",
   "owner": "plataforma",
   "path": "infra/redis",
   "summary": "Caché del catálogo y de las sesiones."
  },
  "kafka": {
   "label": "Kafka",
   "kind": "queue",
   "owner": "datos",
   "path": "infra/kafka",
   "summary": "El bus de eventos: pedido.creado, pago.completado, stock.reservado.",
   "doc": {
    "context": "Tres brokers; los eventos se guardan 7 días.",
    "risks": [
     "En las rebajas el retraso de los consumidores llega a 90 s"
    ]
   }
  },
  "pasarela": {
   "label": "Pasarela de pago",
   "kind": "external",
   "path": "—",
   "summary": "El proveedor externo que autoriza las tarjetas."
  },
  "almacen": {
   "label": "Almacén (WMS)",
   "kind": "external",
   "summary": "El sistema del almacén: recibe las reservas y prepara los envíos."
  },
  "lake": {
   "label": "Data lake",
   "kind": "cloud",
   "owner": "datos",
   "path": "data/lake",
   "summary": "Todos los eventos, para analítica y para reentrenar Antifraude."
  },
  "email": {
   "label": "Proveedor de email",
   "kind": "mail",
   "summary": "El servicio externo que envía los emails."
  },
  "reintentos": {
   "label": "Cola de reintentos",
   "kind": "queue",
   "owner": "pagos",
   "path": "services/payments/retry",
   "summary": "Reintenta los cobros que fallan por la pasarela, con espera creciente.",
   "doc": {
    "context": "Nueva en el sprint 42.",
    "todo": [
