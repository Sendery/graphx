          "code": "// rechaza pedidos sin líneas o con importes negativos\nexport function validate(o: Order): Result {\n  if (!o.lines.length) return fail(\"vacío\");\n  return o.total >= 0 ? ok(o) : fail(\"importe\");\n}"
